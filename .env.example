#Database Configuration
CONNECTION_STRING = mongodb://localhost:27017/savvisound

#JWT Configuration
JWT_SECRET = fYXbLj6MyLXD3QJMuGb2fYXbLj6MyLXD3QJMuGb2
JWT_EXPIRES_IN=24h

#Server Configuration
PORT=5005
NODE_ENV=development #change to production in production

#CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://savvisound.com

#Security Configuration
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5

#DNS Configuration
DNS_SERVERS=1.1.1.1,8.8.8.8

#Traefik/Docker Configuration
DOMAIN=savvisound.com
ACME_EMAIL=admin@savvisound.com
# Generate with: docker run --rm httpd:2.4-alpine htpasswd -nbB admin 'your-password'
# Double the $ signs in the hash ($ becomes $$)
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$example-hash-here
