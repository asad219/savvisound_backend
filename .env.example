#Database Configuration
CONNECTION_STRING = mongodb://localhost:27017/savvisound

#JWT Configuration
JWT_SECRET = your-secret-key-min-32-characters
JWT_EXPIRES_IN=24h

#Server Configuration
PORT=5005
NODE_ENV=development #change to production in production

#CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,https://savvisound.com

#Security Configuration
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5